<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Habit Tracker</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
            background-color: #ADD8E6;
            color: #1c5985;            ;
            text-align: center;
        }
        h2 {
            position: fixed;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            max-width: 900px;
            background: linear-gradient(135deg, #823fc9, #356bc7);
            color: white;
            padding: 15px 20px;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        .message{
            padding:60px;
        }
        .tracker-container {
            width: 60%;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        }
        button {
            background: #1E90FF;
            color: white;
            border: none;
            padding: 10px;
            margin: 10px;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background: #1565C0;
        }
        .habit {
            margin: 10px 0;
            padding: 10px;
            background: #E3F2FD;
            border-radius: 5px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .checkboxes label {
            display: inline-block;
            margin: 5px;
        }
        .checkboxes input {
            appearance: none;
            width: 20px;
            height: 20px;
            border: 2px solid #1E90FF;
            border-radius: 50%;
            cursor: pointer;
            transition: 0.3s;
        }
        .checkboxes input:checked {
            background-color: #1E90FF;
        }
        .progress-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }
        .chart-container {
            width: 250px;
            height: 250px;
            position: relative;
        }
        .chart-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 18px;
            font-weight: bold;
            color: #1E90FF;
        }

        .container {
            width: 60%;
            margin-top: 40px;
            background: white;
            padding: 20px;
            border-radius: 10px;
            display: inline-block;
        }
        .entry {
            margin-top: 10px;
            padding: 10px;
            background: #bccdde;
            border-radius: 5px;
        }
        #chartsContainer {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="message">
        <h2>Small steps lead to big changes! 🌱 
            Every tick is progress, and every day is a chance to grow. 
            Keep going — you’re building a better you!</h2>
    </div>
    <div class="tracker-container">
        <h1>Habit Tracker</h1>
        <label for="month">Select Month:</label>
        <select id="month"></select>
        <button id="addHabit">Add Habit</button>
        <div id="habits"></div>
        <button id="showProgress">Show Progress</button>
        <div id="progressCharts" class="progress-container"></div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
    const monthSelect = document.getElementById("month");
    const addHabitButton = document.getElementById("addHabit");
    const habitsContainer = document.getElementById("habits");
    const showProgressButton = document.getElementById("showProgress");
    const progressChartsContainer = document.getElementById("progressCharts");

    const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    
    months.forEach((month, index) => {
        const option = document.createElement("option");
        option.value = index + 1;
        option.textContent = month;
        monthSelect.appendChild(option);
    });

    function saveHabits() {
        const habits = [];
        document.querySelectorAll(".habit").forEach(habitDiv => {
            const title = habitDiv.querySelector("h3").textContent;
            const checkboxes = [...habitDiv.querySelectorAll("input[type='checkbox']")].map(cb => cb.checked);
            habits.push({ title, checkboxes });
        });
        localStorage.setItem("habits", JSON.stringify(habits));
    }

    function loadHabits() {
    const savedHabits = JSON.parse(localStorage.getItem("habits")) || [];
    habitsContainer.innerHTML = "";

    savedHabits.forEach(({ title, checkboxes }, index) => {
        const habitDiv = document.createElement("div");
        habitDiv.classList.add("habit");

        const titleElement = document.createElement("h3");
        titleElement.textContent = title;
        habitDiv.appendChild(titleElement);

        const checkboxesContainer = document.createElement("div");
        checkboxesContainer.classList.add("checkboxes");

        checkboxes.forEach((checked, i) => {
            const label = document.createElement("label");
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.dataset.day = i + 1;
            checkbox.checked = checked;
            checkbox.addEventListener("change", saveHabits);
            label.appendChild(checkbox);
            label.appendChild(document.createTextNode(i + 1));
            checkboxesContainer.appendChild(label);
        });

        habitDiv.appendChild(checkboxesContainer);

        // Add DELETE Button
        const deleteButton = document.createElement("button");
        deleteButton.textContent = "Delete";
        deleteButton.style.backgroundColor = "#FF6347"; 
        deleteButton.style.marginTop = "10px";
        deleteButton.addEventListener("click", () => deleteHabit(index));
        
        habitDiv.appendChild(deleteButton);
        habitsContainer.appendChild(habitDiv);
    });
}

function deleteHabit(index) {
    let habits = JSON.parse(localStorage.getItem("habits")) || [];
    habits.splice(index, 1); 
    localStorage.setItem("habits", JSON.stringify(habits));
    loadHabits(); 
}

    addHabitButton.addEventListener("click", () => {
        const habitName = prompt("Enter habit name:");
        if (habitName) {
            const selectedMonth = monthSelect.value;
            const daysInMonth = new Date(2024, selectedMonth, 0).getDate();
            const habitDiv = document.createElement("div");
            habitDiv.classList.add("habit");

            const title = document.createElement("h3");
            title.textContent = `${habitName} - ${months[selectedMonth - 1]}`;
            habitDiv.appendChild(title);

            const checkboxesContainer = document.createElement("div");
            checkboxesContainer.classList.add("checkboxes");

            for (let i = 1; i <= daysInMonth; i++) {
                const label = document.createElement("label");
                const checkbox = document.createElement("input");
                checkbox.type = "checkbox";
                checkbox.dataset.day = i;
                checkbox.addEventListener("change", saveHabits);
                label.appendChild(checkbox);
                label.appendChild(document.createTextNode(i));
                checkboxesContainer.appendChild(label);
            }

            habitDiv.appendChild(checkboxesContainer);
            habitsContainer.appendChild(habitDiv);
            saveHabits();
        }
    });

    showProgressButton.addEventListener("click", () => {
        progressChartsContainer.innerHTML = "";
        document.querySelectorAll(".habit").forEach(habitDiv => {
            const habitName = habitDiv.querySelector("h3").textContent;
            const checkboxes = habitDiv.querySelectorAll("input[type='checkbox']");
            const completed = [...checkboxes].filter(cb => cb.checked).length;
            const total = checkboxes.length;
            const progress = total > 0 ? Math.round((completed / total) * 100) : 0;

            const chartContainer = document.createElement("div");
            chartContainer.classList.add("chart-container");

            const canvas = document.createElement("canvas");
            const textOverlay = document.createElement("div");
            textOverlay.classList.add("chart-text");
            textOverlay.textContent = `${progress}%`;

            chartContainer.appendChild(canvas);
            chartContainer.appendChild(textOverlay);
            progressChartsContainer.appendChild(chartContainer);

            new Chart(canvas, {
                type: "doughnut",
                data: {
                    labels: ["Completed", "Remaining"],
                    datasets: [{
                        data: [completed, total - completed],
                        backgroundColor: ["#1E90FF", "#ADD8E6"]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: habitName
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return tooltipItem.label + ": " + tooltipItem.raw + " days";
                                }
                            }
                        }
                    }
                }
            });
        });
    });

    loadHabits();
});

    </script>
    <div class="container">
        <h1>Health Tracker</h1>
        <label for="characteristic">Select Characteristic:</label>
        <select id="characteristic">
            <option value="Height">Height</option>
            <option value="Weight">Weight</option>
        </select>
        
        <input type="number" id="valueInput" placeholder="Enter Value">
        <button onclick="addEntry()">Add Entry</button>
        <div id="entriesContainer"></div>
        <button onclick="showProgress()">Show Progress</button>
        <div id="chartsContainer"></div>
    </div>

    <script>
        let entries = JSON.parse(localStorage.getItem("entries")) || [];

        function saveEntries() {
            localStorage.setItem("entries", JSON.stringify(entries));
        }

        function addEntry() {
            let characteristic = document.getElementById("characteristic").value;
            let value = parseFloat(document.getElementById("valueInput").value);
            if (!isNaN(value)) {
                entries.push({ characteristic, value, date: new Date().toLocaleDateString() });
                saveEntries();
                renderEntries();
                document.getElementById("valueInput").value = "";
            }
        }

        function editEntry(index) {
            let newValue = prompt("Enter new value:", entries[index].value);
            if (newValue !== null && !isNaN(parseFloat(newValue))) {
                entries[index].value = parseFloat(newValue);
                saveEntries();
                renderEntries();
            }
        }

        function deleteEntry(index) {
            if (confirm("Are you sure you want to delete this entry?")) {
                entries.splice(index, 1);
                saveEntries();
                renderEntries();
            }
        }

        function renderEntries() {
            let container = document.getElementById("entriesContainer");
            container.innerHTML = "";
            entries.forEach((entry, index) => {
                let entryDiv = document.createElement("div");
                entryDiv.classList.add("entry");
                entryDiv.innerHTML = `<strong>${entry.characteristic}</strong>: ${entry.value} (${entry.date})
                    <button onclick="editEntry(${index})">Edit</button>
                    <button onclick="deleteEntry(${index})">Delete</button>`;
                container.appendChild(entryDiv);
            });
        }

        function showProgress() {
            let chartsContainer = document.getElementById("chartsContainer");
            chartsContainer.innerHTML = "";
            let groupedEntries = entries.reduce((acc, entry) => {
                if (!acc[entry.characteristic]) acc[entry.characteristic] = [];
                acc[entry.characteristic].push(entry);
                return acc;
            }, {});
            Object.keys(groupedEntries).forEach((characteristic) => {
                let chartContainer = document.createElement("div");
                chartContainer.classList.add("chart-container");
                let canvas = document.createElement("canvas");
                chartContainer.appendChild(canvas);
                chartsContainer.appendChild(chartContainer);
                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: groupedEntries[characteristic].map(e => e.date),
                        datasets: [{
                            label: characteristic,
                            data: groupedEntries[characteristic].map(e => e.value),
                            backgroundColor: "#2596be",
                            borderColor: "#1565C0",
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            title: {
                                display: true,
                                text: characteristic
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (tooltipItem) {
                                        return tooltipItem.raw + " recorded on " + tooltipItem.label;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            });
        }

        document.addEventListener("DOMContentLoaded", renderEntries);
    </script>
</body>
</html>
